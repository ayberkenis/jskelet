<section class="wrapper max-w-prose">
  <h1 class="text-2xl font-bold">İletişim</h1>

  <% if (sent) { %>
  <p class="mt-4 rounded border border-emerald-300 bg-emerald-50 p-3 text-sm">
    Mesajınız alındı, teşekkürler.
  </p>
  <% } %>

  <%#
    Klasik form POST'u: JS gelmeden de çalışır. Island yalnızca doğrulama ve
    "gönderiliyor" durumunu ekler — progressive enhancement.
  -%>
  <form method="post" action="/iletisim" class="mt-6 flex flex-col gap-4" data-island="contact-form">
    <label class="flex flex-col gap-1 text-sm">
      Mesajınız
      <textarea
        name="message"
        rows="5"
        required
        class="rounded border border-slate-300 px-3 py-2"
      ></textarea>
    </label>

    <p class="m-0 hidden text-sm text-red-600" data-form-error></p>

    <button
      type="submit"
      class="self-start rounded bg-slate-900 px-4 py-2 text-sm text-white disabled:opacity-60"
    >Gönder</button>
  </form>
</section>
