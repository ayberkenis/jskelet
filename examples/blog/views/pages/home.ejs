<section class="wrapper">
  <h2 class="text-2xl font-bold">Son yazılar</h2>

  <div class="mt-6 grid gap-5 sm:grid-cols-2">
    <% posts.slice(0, 2).forEach(function (post) { %>
    <%- postCard({ post }) %>
    <% }); %>
  </div>

  <%#
    Sekmeli widget. Sunucu yalnızca aktif paneli basar; diğer paneller
    `data-tab-src` ile işaretlenir ve tıklandığında (ya da fare üstüne
    geldiğinde önden) `/_fragment/*` üzerinden gelir.
  -%>
  <div class="mt-12" data-island="tabs">
    <h2 class="text-2xl font-bold">Etikete göre</h2>

    <div class="mt-4 flex gap-2" role="tablist">
      <% tags.forEach(function (tag, index) { %>
      <button
        type="button"
        role="tab"
        class="rounded border border-slate-300 px-3 py-1 text-sm data-[active=true]:bg-slate-900 data-[active=true]:text-white"
        data-tab="<%= tag %>"
        data-active="<%= index === 0 %>"
      >#<%= tag %></button>
      <% }); %>
    </div>

    <%#
      `forEach` değil `for`: EJS'in `include`'u async ve `await` yalnızca
      şablonun kendi gövdesinde geçerli — bir callback fonksiyonunun içinde
      derleme hatası verir.
    -%>
    <% for (let index = 0; index < tags.length; index++) {
         const tag = tags[index]; %>
    <div
      role="tabpanel"
      class="mt-4"
      data-tab-panel="<%= tag %>"
      <%= index === 0 ? "" : "hidden" %>
      <%# Aktif olmayan panel yalnızca kaynak adresini taşır, içerik taşımaz. -%>
      <%- index === 0 ? "" : `data-tab-src="/_fragment/posts-by-tag?tag=${tag}"` %>
    ><% if (index === 0) { %><%- await include('partials/post-rows', { posts: posts.filter((post) => post.tags.includes(tag)) }) %><% } %></div>
    <% } %>
  </div>
</section>
