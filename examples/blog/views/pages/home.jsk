<section class="wrapper">
  <h2 class="text-2xl font-bold">Son yazılar</h2>

  <div class="mt-6 grid gap-5 sm:grid-cols-2">
    {#each featuredPosts as post}
    <PostCard :post="post" />
    {/each}
  </div>

  {#
    Sekmeli widget. Sunucu yalnızca aktif paneli basar; diğer paneller
    `data-tab-src` ile işaretlenir ve tıklandığında (ya da fare üstüne
    geldiğinde önden) `/_fragment/*` üzerinden gelir. Dilim/filtre
    controller'da `tagPanels` olarak hazırlanır.
  #}
  <div class="mt-12" data-island="tabs">
    <h2 class="text-2xl font-bold">Etikete göre</h2>

    <div class="mt-4 flex gap-2" role="tablist">
      {#each tagPanels as panel}
      <button
        type="button"
        role="tab"
        class="rounded border border-slate-300 px-3 py-1 text-sm data-[active=true]:bg-slate-900 data-[active=true]:text-white"
        :data-tab="panel.tag"
        :data-active="panel.active ? 'true' : 'false'"
      >#{{ panel.tag }}</button>
      {/each}
    </div>

    {#each tagPanels as panel}
    <div
      role="tabpanel"
      class="mt-4"
      :data-tab-panel="panel.tag"
      :hidden="panel.hidden"
      :data-tab-src="panel.tabSrc"
    >{#if panel.active}<PostRows :posts="panel.posts" />{/if}</div>
    {/each}
  </div>
</section>
