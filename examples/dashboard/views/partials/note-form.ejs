<%#
  Not formu.

  `data-enhance` formu `form.js`e bağlar: gönderim fetch ile gider,
  `data-target` başarılı yanıtın nereye takılacağını söyler. Doğrulama
  hatasında sunucu 422 ile **bu şablonu** döndürür ve form kendisiyle
  değiştirilir; hata mesajı ve girilen metin korunur.

  `data-enhance` kaldırılsa her şey çalışmaya devam eder: tarayıcı formu
  normal gönderir, sunucu 303 ile paneli yeniden açar. Aradaki tek fark tam
  sayfa turu.

  Hata durumunda yeniden basıldığı için `csrfField()` burada da çağrılıyor —
  ikinci deneme token'sız kalmasın.
-%>
<form method="post" action="/panel/notlar" data-enhance data-target="#notlar"
  class="rounded-lg border border-slate-200 bg-white p-4">
  <%- csrfField() %>

  <label for="metin" class="block text-sm font-medium">Yeni not</label>

  <textarea id="metin" name="metin" rows="2" required minlength="3" maxlength="200"
    <%- hata ? 'aria-invalid="true" aria-describedby="metin-hata"' : '' %>
    class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm"><%= metin %></textarea>

  <% if (hata) { %>
  <p id="metin-hata" role="alert" data-field-error class="mt-2 text-sm text-red-700">
    <%= hata %>
  </p>
  <% } %>

  <button type="submit"
    class="mt-3 rounded-md bg-slate-900 px-3 py-1.5 text-sm font-medium text-white hover:bg-slate-700">
    Kaydet
  </button>
</form>
