<%#
  `hooks.layoutContext()` döndürdüğü her alan burada local: nav, pathname,
  structuredData, bodyClass.

  Bu sitede font preload yok, çünkü web font de yok. Head'de global stylesheet
  ve isteğe bağlı sayfa sheet'leri; JS entry defer edilmiş modül olduğu için
  render'ı bloke etmiyor.
-%>
<!DOCTYPE html>
<%#
  Arka plan rengi bilinçli olarak `<html>`de, `<body>`de değil: view transition
  sırasında gövdenin arka planı anlık görüntünün içinde kalır ve altta kalan
  canvas görünür. Koyu temada bu, geçiş başına bir kare beyaz flaş demek.
-%>
<html lang="<%= lang %>" class="h-full scroll-smooth bg-white antialiased dark:bg-ink-950">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%#
      `color-scheme` head'in en başında bildirilmek zorunda: tarayıcı yeni
      belgenin ilk karesini boyarken henüz stylesheet'i uygulamamış olur ve
      varsayılan tuvali beyaz kabul eder. Koyu temada gezinme başına bir kare
      beyaz flaş tam olarak bu. `light dark` tuvali işletim sistemi tercihine
      bağlar; localStorage'daki seçim tercihten farklıysa satır içi script aynı
      karede şemayı sabitler.
    -%>
    <meta name="color-scheme" content="light dark">
    <meta name="theme-color" content="#020617" media="(prefers-color-scheme: dark)">
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
    <%# Kaynak ipuçları en başta; preconnect'i geciktirmek doğrudan LCP'ye yazılır. %>
    <%- extraHead %>
    <% if (hasAsset('app.css')) { %>
    <link rel="stylesheet" href="<%= asset('app.css') %>" data-jskelet-css="app.css">
    <% } %>
    <% styles.forEach(function (sheet) { %>
      <% if (hasAsset(sheet)) { %>
    <link rel="stylesheet" href="<%= asset(sheet) %>" data-jskelet-css="<%= sheet %>">
      <% } %>
    <% }); %>
    <%- headMeta %>
    <% structuredData.forEach(function (item) { %>
    <script type="application/ld+json"><%- jsonScript(item) %></script>
    <% }); %>
    <%#
      Tema kararı client'ta veriliyor ama ilk boyamadan önce uygulanmak zorunda:
      aksi halde koyu tema tercih eden kullanıcı bir kare beyaz görür. Bu yüzden
      küçük ve satır içi; island'a bırakılamaz çünkü island'ın modülü sonra iner.
    -%>
    <script>
      try {
        var stored = localStorage.getItem("jskelet-theme");
        var dark = stored
          ? stored === "dark"
          : matchMedia("(prefers-color-scheme: dark)").matches;
        var root = document.documentElement;
        if (dark) root.classList.add("dark");
        // Sınıfla birlikte şema da sabitlenir; aksi halde tuval OS tercihinde
        // kalır ve saklanmış seçim tersse ilk kare yanlış renkte boyanır.
        root.style.colorScheme = dark ? "dark" : "light";
      } catch (error) {
        void error;
      }
    </script>
  </head>
  <body class="<%= bodyClass %> flex min-h-full flex-col font-sans text-slate-950 dark:text-slate-100">
    <a
      href="#content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:rounded focus:bg-slate-900 focus:px-3 focus:py-2 focus:text-white"
    ><%= t.ui.skipToContent %></a>

    <%- await include('partials/header') %>

    <main id="content" class="min-w-0 flex-1"><%- body %></main>

    <%- await include('partials/footer') %>

    <%# Overlay portal: `overflow: hidden` taşıyan bir ata element modalı kırpmasın. %>
    <div id="jskelet-overlays"></div>

    <script type="module" src="<%= asset('main.js') %>"></script>
    <% entries.forEach(function (entry) { %>
    <script type="module" src="<%= asset(entry) %>"></script>
    <% }); %>
    <% if (devtools) { %>
    <script type="module" src="<%= devBasePath %>/overlay.js"></script>
    <% } %>
  </body>
</html>
