<%#
  Sürüm notları. Liste CHANGELOG.md'den ayrıştırılıyor; üstteki sayılar da
  aynı kayıttan hesaplanıyor — uydurma kanal / yıldız yok.
-%>
<section class="glow relative overflow-hidden border-b border-slate-200 dark:border-white/10">
  <div class="grid-surface pointer-events-none absolute inset-0" aria-hidden="true"></div>
  <div class="wrapper relative py-16 sm:py-24">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <%- sectionHead(t.changelog.hero) %>
      <%- link({
        href: "https://github.com/ayberkenis/jskelet/blob/master/CHANGELOG.md",
        html: `${esc(t.changelog.sourceLink)}${icon({ name: "ArrowSquareOut", size: 14 })}`,
        rel: "noopener",
        class: "inline-flex items-center gap-1.5 text-sm font-semibold text-slate-500 hover:text-cyan-700 dark:text-slate-400 dark:hover:text-brand-300",
      }) %>
    </div>

    <%
      const releasedEntries = entries.filter((entry) => !entry.unreleased);
      const breakingCount = entries.filter((entry) =>
        entry.groups.some((group) => group.type === "breaking"),
      ).length;
      const latestEntry = releasedEntries[0] || { version: release.version, date: "" };
    %>

    <div class="mt-10">
      <%- changelogStats({
        total: entries.length,
        released: releasedEntries.length,
        breaking: breakingCount,
        latest: { version: latestEntry.version, date: latestEntry.date || "" },
        labels: t.changelog,
      }) %>
    </div>
  </div>
</section>

<section
  class="wrapper py-12 sm:py-14"
  data-island="changelog-browse"
  data-island-eager
  data-island-props='<%= JSON.stringify({
    showing: t.changelog.showing,
    page: t.changelog.pageLabel,
    empty: t.changelog.searchEmpty,
  }) %>'
>
  <% if (!entries.length) { %>
  <p class="m-0 rounded-2xl border border-slate-200 bg-white p-6 text-sm/6 text-slate-600 dark:border-white/10 dark:bg-white/[0.03] dark:text-slate-400">
    <%= t.changelog.empty %>
  </p>
  <% } else { %>
  <%- changelogToolbar({ labels: t.changelog, total: entries.length }) %>

  <div class="mt-8 grid gap-5" data-changelog-list>
    <%
      const latestVersion = releasedEntries[0] && releasedEntries[0].version;
      entries.forEach(function (entry) {
    %>
    <%- changelogEntry({
      entry,
      labels: {
        ...t.changelog,
        copyDone: t.ui.copied,
        copyFailed: t.ui.copyFailed,
      },
      current: entry.version === release.version,
      latest: entry.version === latestVersion,
      render: renderChange,
    }) %>
    <% }); %>
  </div>
  <% } %>
</section>

<section class="border-t border-slate-200 bg-slate-50 py-16 dark:border-white/10 dark:bg-white/[0.02]">
  <div class="wrapper flex flex-col items-start gap-6 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h2 class="m-0 text-2xl font-bold tracking-tight"><%= t.changelog.cta.title %></h2>
      <p class="mt-2 mb-0 text-sm/6 text-slate-600 dark:text-slate-300"><%= t.changelog.cta.body %></p>
    </div>
    <div class="flex flex-wrap gap-3">
      <%- buttonLink({ href: paths.download, text: t.changelog.cta.primary, icon: "DownloadSimple" }) %>
      <%- buttonLink({ href: paths.docs, text: t.changelog.cta.secondary, variant: "ghost" }) %>
    </div>
  </div>
</section>
