{#
  Sürüm notları. Liste CHANGELOG.md'den ayrıştırılıyor; üstteki sayılar da
  aynı kayıttan hesaplanıyor — uydurma kanal / yıldız yok.
#}
<section class="page-hero glow">
  <div class="grid-surface pointer-events-none absolute inset-0" aria-hidden="true"></div>
  <div class="wrapper relative py-16 sm:py-24">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <SectionHead :section="t.changelog.hero" :level="1" />
      <a
        href="https://github.com/ayberkenis/jskelet/blob/master/CHANGELOG.md"
        rel="noopener"
        class="inline-flex items-center gap-1.5 text-sm font-semibold text-slate-500 hover:text-cyan-700 dark:text-slate-400 dark:hover:text-brand-300"
      >
        {{ t.changelog.sourceLink }}
        <Icon name="ArrowSquareOut" :size="14" />
      </a>
    </div>

    <div class="mt-10">
      <ChangelogStats
        :total="changelogStatsData.total"
        :released="changelogStatsData.released"
        :breaking="changelogStatsData.breaking"
        :latest="changelogStatsData.latest"
        :labels="changelogStatsData.labels"
      />
    </div>
  </div>
</section>

<section
  class="wrapper py-12 sm:py-14"
  data-island="changelog-browse"
  data-island-eager
  :data-island-props="changelogBrowseProps"
>
  {#if !entries.length}
  <p class="glass-panel m-0 p-6 text-sm/6 text-slate-600 dark:text-slate-400">
    {{ t.changelog.empty }}
  </p>
  {#else}
  <ChangelogToolbar :labels="t.changelog" :total="entries.length" />

  <div class="mt-8 grid gap-5" data-changelog-list>
    {#each changelogCards as card}
    <ChangelogEntry
      :entry="card.entry"
      :labels="changelogLabels"
      :current="card.current"
      :latest="card.latest"
      :render="renderChange"
    />
    {/each}
  </div>
  {/if}
</section>

<section class="border-t border-slate-200 bg-slate-50 py-16 dark:border-white/10 dark:bg-white/[0.02]">
  <div class="wrapper flex flex-col items-start gap-6 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h2 class="m-0 text-2xl font-bold tracking-tight">{{ t.changelog.cta.title }}</h2>
      <p class="mt-2 mb-0 text-sm/6 text-slate-600 dark:text-slate-300">{{ t.changelog.cta.body }}</p>
    </div>
    <div class="flex flex-wrap gap-3">
      <ButtonLink :href="paths.download" :text="t.changelog.cta.primary" icon="DownloadSimple" />
      <ButtonLink :href="paths.docs" :text="t.changelog.cta.secondary" variant="ghost" />
    </div>
  </div>
</section>
