<section class="border-b border-slate-200 dark:border-slate-800">
  <div class="wrapper py-16 sm:py-20">
    <%- sectionHead({
      eyebrow: "Kıyaslama",
      title: "Takaslar, hız iddiaları değil",
      lead: "Aşağıdaki tablo kimin daha hızlı olduğunu söylemiyor: hangi kararın neyi mümkün, neyi imkânsız kıldığını söylüyor. JSkelet'in kaybettiği satırlar da tabloda.",
    }) %>
  </div>
</section>

<section class="wrapper py-14">
  <%- compareTable(comparison) %>

  <p class="mt-4 text-xs text-slate-500 dark:text-slate-400">
    <span class="font-mono text-emerald-600 dark:text-emerald-400">+</span> bu
    yaklaşımın avantajı ·
    <span class="font-mono text-rose-600 dark:text-rose-400">−</span> bilinçli
    ya da yapısal eksik ·
    <span class="font-mono">•</span> nötr, yalnızca farklı.
  </p>
</section>

<section class="border-y border-slate-200 bg-slate-50 py-16 dark:border-slate-800 dark:bg-slate-900/30">
  <div class="wrapper">
    <%- sectionHead({
      eyebrow: "Canlı ölçüm",
      title: "Cache'in farkını kendi tarayıcınızda ölçün",
      lead: "Aşağıdaki iki sayı, siz bu bölümü görünce ölçülüyor. İki uç da aynı sunucuda, aynı şablon motorunda ve aynı ağda; tek fark birinin HTML TTL cache'inde durması.",
    }) %>

    <%#
      Island görünürlükte hidre olur, yani ölçüm sayfa açılışındaki ağ
      yoğunluğuna karışmaz ve LCP'ye yazılmaz.
    -%>
    <div
      class="mt-10 grid gap-5 sm:grid-cols-2"
      data-island="latency"
      data-runs="6"
      data-cached-url="/"
      data-fresh-url="/_fragment/render-demo"
    >
      <div class="rounded-xl border border-sky-200 bg-white p-6 dark:border-sky-500/30 dark:bg-slate-900/40">
        <p class="m-0 text-sm font-medium">Cache'ten dönen sayfa</p>
        <p class="mt-2 mb-0 font-mono text-3xl font-semibold tabular-nums" data-latency-value="cached">ölçülüyor…</p>
        <p class="mt-2 mb-0 font-mono text-xs text-slate-500 dark:text-slate-400" data-latency-cache="cached">&nbsp;</p>
        <p class="mt-3 mb-0 text-xs text-slate-500 dark:text-slate-400">
          <code class="font-mono">/</code> — bellekten servis edilir, controller
          hiç çalışmaz.
        </p>
      </div>

      <div class="rounded-xl border border-slate-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-900/40">
        <p class="m-0 text-sm font-medium">Her istekte render edilen parça</p>
        <p class="mt-2 mb-0 font-mono text-3xl font-semibold tabular-nums" data-latency-value="fresh">ölçülüyor…</p>
        <p class="mt-2 mb-0 font-mono text-xs text-slate-500 dark:text-slate-400" data-latency-cache="fresh">&nbsp;</p>
        <p class="mt-3 mb-0 text-xs text-slate-500 dark:text-slate-400">
          <code class="font-mono">/_fragment/render-demo</code> —
          <code class="font-mono">no-store</code>, EJS her seferinde çalışır.
        </p>
      </div>

      <p class="text-xs text-slate-500 sm:col-span-2 dark:text-slate-400" data-latency-status>
        JavaScript kapalıysa bu bölüm ölçüm yapmaz; sayfanın kalanı etkilenmez.
      </p>
    </div>

    <p class="mt-6 max-w-3xl text-sm text-slate-600 dark:text-slate-300">
      Yerelde iki sayı da milisaniyeler mertebesinde çıkar ve fark küçük görünür;
      önemli olan cache'li tarafın <strong>veri kaynağından bağımsız</strong>
      olması. Controller bir API'ye ya da veritabanına gidiyorsa MISS maliyeti o
      çağrının maliyetidir, HIT maliyeti değişmez.
    </p>
  </div>
</section>

<section class="wrapper py-16">
  <%- sectionHead({
    eyebrow: "Ölçülen ağırlık",
    title: "Bu sitenin build çıktısı",
    lead: "Karşılaştırma tablosundaki 'boş sayfada client JS' satırının bu projedeki karşılığı.",
  }) %>

  <div class="mt-8 max-w-2xl"><%- payloadTable(payload) %></div>
</section>

<section class="border-t border-slate-200 py-16 dark:border-slate-800">
  <div class="wrapper">
    <%- sectionHead({
      eyebrow: "Seçim",
      title: "Tabloyu kendi projenize uygulayın",
      lead: "Satırların çoğu nötr; kararı belirleyen genelde son iki satır.",
    }) %>

    <div class="mt-10 grid gap-5 md:grid-cols-2">
      <%- fitList({ title: "İyi uyum", items: fit.good, tone: "good" }) %>
      <%- fitList({ title: "Yanlış seçim", items: fit.bad, tone: "bad" }) %>
    </div>

    <div class="mt-10 flex flex-wrap gap-3">
      <%- buttonLink({ href: "/tasima", text: "Next.js'ten taşıma", icon: "ArrowRight" }) %>
      <%- buttonLink({ href: "/nasil-calisir", text: "Nasıl çalışır", variant: "ghost" }) %>
    </div>
  </div>
</section>
