<section class="page-hero glow">
  <div class="grid-surface pointer-events-none absolute inset-0" aria-hidden="true"></div>
  <div class="wrapper relative py-20 sm:py-28">
    <SectionHead :section="t.compare.hero" :level="1" />
  </div>
</section>

<section class="wrapper py-14">
  <CompareTable :columns="comparison.columns" :rows="comparison.rows" />

  <p class="mt-4 flex flex-wrap gap-x-4 gap-y-1 text-xs text-slate-600 dark:text-slate-400">
    <span><span class="font-mono font-bold text-emerald-700 dark:text-emerald-300">+</span> {{ t.comparison.legend.good }}</span>
    <span><span class="font-mono font-bold text-rose-700 dark:text-rose-300">−</span> {{ t.comparison.legend.bad }}</span>
    <span><span class="font-mono font-bold">•</span> {{ t.comparison.legend.neutral }}</span>
  </p>
</section>

<section class="border-y border-slate-200 bg-slate-50 py-16 dark:border-white/10 dark:bg-white/[0.02]">
  <div class="wrapper">
    <SectionHead :section="t.compare.live" />

    {#
      Island görünürlükte hidre olur, yani ölçüm sayfa açılışındaki ağ
      yoğunluğuna karışmaz ve LCP'ye yazılmaz. İki uç aynı şablonu üretir;
      tek fark cache — aksi hâlde büyük HTML ile küçük fragment kıyaslanır
      ve transfer süresi sonucu ters çevirebilir.
    #}
    <div
      class="mt-10 grid gap-5 sm:grid-cols-2"
      data-island="latency"
      :data-island-props="latencyProps"
    >
      <div class="relative overflow-hidden rounded-3xl border border-cyan-200 bg-gradient-to-br from-cyan-50 to-white p-7 shadow-xl shadow-cyan-950/5 dark:border-brand-400/25 dark:from-brand-400/10 dark:to-white/[0.03]">
        <span class="absolute top-5 right-5 inline-flex items-center gap-2 text-[10px] font-bold tracking-wider text-emerald-700 uppercase dark:text-emerald-300">
          <span class="status-pulse size-2 rounded-full bg-emerald-400"></span> {{ t.compare.live.cachedBadge }}
        </span>
        <p class="m-0 text-sm font-semibold">{{ t.compare.live.cachedLabel }}</p>
        <p class="mt-5 mb-0 font-mono text-4xl font-bold tracking-tight tabular-nums" data-latency-value="cached">{{ t.compare.live.measuring }}</p>
        <p class="mt-2 mb-0 font-mono text-xs text-emerald-700 dark:text-emerald-300" data-latency-produce="cached">&nbsp;</p>
        <p class="mt-2 mb-0 font-mono text-xs text-slate-600 dark:text-slate-400" data-latency-cache="cached">&nbsp;</p>
        <p class="mt-1 mb-0 font-mono text-xs text-slate-500 dark:text-slate-500" data-latency-bytes="cached">&nbsp;</p>
        <p class="mt-3 mb-0 text-xs/5 text-slate-600 dark:text-slate-400">
          <code class="font-mono">/_fragment/render-demo-cached</code> — {{ t.compare.live.cachedNote }}
        </p>
      </div>

      <div class="relative overflow-hidden rounded-3xl border border-slate-200 bg-white p-7 shadow-xl shadow-slate-950/5 dark:border-white/10 dark:bg-white/[0.035]">
        <span class="absolute top-5 right-5 text-[10px] font-bold tracking-wider text-slate-600 uppercase dark:text-slate-400">{{ t.compare.live.freshBadge }}</span>
        <p class="m-0 text-sm font-semibold">{{ t.compare.live.freshLabel }}</p>
        <p class="mt-5 mb-0 font-mono text-4xl font-bold tracking-tight tabular-nums" data-latency-value="fresh">{{ t.compare.live.measuring }}</p>
        <p class="mt-2 mb-0 font-mono text-xs text-amber-700 dark:text-amber-300" data-latency-produce="fresh">&nbsp;</p>
        <p class="mt-2 mb-0 font-mono text-xs text-slate-600 dark:text-slate-400" data-latency-cache="fresh">&nbsp;</p>
        <p class="mt-1 mb-0 font-mono text-xs text-slate-500 dark:text-slate-500" data-latency-bytes="fresh">&nbsp;</p>
        <p class="mt-3 mb-0 text-xs/5 text-slate-600 dark:text-slate-400">
          <code class="font-mono">/_fragment/render-demo</code> — {{ t.compare.live.freshNote }}
        </p>
      </div>

      <p class="text-xs text-slate-600 sm:col-span-2 dark:text-slate-400" data-latency-status>
        {{ t.compare.live.status }}
      </p>
    </div>

    <p class="mt-6 max-w-3xl text-sm/6 text-slate-600 dark:text-slate-300">
      {{ t.compare.live.footnote }}
    </p>
  </div>
</section>

<section class="wrapper py-16">
  <SectionHead :section="t.compare.source" />
  <div class="mt-10">
    <SourceContrast :left="t.compare.source.panels.left" :right="t.compare.source.panels.right" />
  </div>
  <ul class="mt-8 grid list-none gap-3 p-0 text-sm/6 text-slate-600 sm:grid-cols-3 dark:text-slate-300">
    {#each t.compare.source.points as point}
    <li class="glass-panel p-5">
      <p class="m-0 text-xs font-bold tracking-[0.18em] text-cyan-700 uppercase dark:text-cyan-300">{{ point.label }}</p>
      <p class="mt-2 mb-0">{{ point.text }}</p>
    </li>
    {/each}
  </ul>
</section>

<section class="border-y border-slate-200 bg-slate-50 py-16 dark:border-white/10 dark:bg-white/[0.02]">
  <div class="wrapper">
    <SectionHead :section="t.compare.weight" />

    <div class="mt-8 grid gap-8 lg:grid-cols-2 lg:items-start">
      <PayloadTable :payload="payload" :labels="t.payloadLabels" />

      {#if payload.entries.length}
      <div class="glass-panel p-6">
        <BarGroup :items="barItems" />
      </div>
      {/if}
    </div>

    {#if weightOurs && weightNext}
    <WeightContrast :ours="weightOurs" :next="weightNext" />
    {/if}
  </div>
</section>

<section class="wrapper py-16">
  <SectionHead :section="t.compare.apply" />

  <div class="mt-10 grid gap-5 md:grid-cols-2">
    <FitList :title="t.fit.title.good" :items="fit.good" tone="good" />
    <FitList :title="t.fit.title.bad" :items="fit.bad" tone="bad" />
  </div>

  <div class="mt-10 flex flex-wrap gap-3">
    <ButtonLink :href="paths.migrate" :text="t.compare.apply.ctaPrimary" icon="ArrowRight" />
    <ButtonLink :href="paths.howItWorks" :text="t.compare.apply.ctaSecondary" variant="ghost" />
  </div>
</section>
