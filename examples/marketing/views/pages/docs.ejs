<section class="border-b border-slate-200 dark:border-slate-800">
  <div class="wrapper py-16 sm:py-20">
    <%- sectionHead({
      eyebrow: "Belgeler",
      title: "On bir bölüm",
      lead: "Belgeler kararların gerekçelerini taşıyor; bir davranışı değiştirmeden önce ilgili bölümü okumak çoğu 'iyileştirme' fikrinin zaten tartışıldığını gösteriyor.",
    }) %>
  </div>
</section>

<section class="wrapper py-14">
  <div class="grid gap-4 sm:grid-cols-2">
    <% docs.forEach(function (item) { %>
    <%- link({
      href: `https://github.com/ayberkenis/jskelet/blob/master/docs/${item.file}.md`,
      class: "group rounded-xl border border-slate-200 p-5 transition-colors hover:border-slate-400 dark:border-slate-800 dark:hover:border-slate-600",
      html: `<span class="font-mono text-xs text-slate-400">${esc(item.file)}</span>
        <span class="mt-1 block font-semibold group-hover:underline">${esc(item.title)}</span>
        <span class="mt-1 block text-sm text-slate-600 dark:text-slate-300">${esc(item.body)}</span>`,
    }) %>
    <% }); %>
  </div>

  <div class="mt-10 grid gap-4 sm:grid-cols-2">
    <%- codeBlock({
      label: "örnekleri çalıştır",
      copyable: true,
      code: "npm --prefix examples/marketing install\nnpm --prefix examples/marketing run dev",
    }) %>

    <div class="rounded-xl border border-slate-200 p-5 text-sm/6 text-slate-600 dark:border-slate-800 dark:text-slate-300">
      <p class="m-0">
        Depoda üç örnek var:
        <code class="font-mono text-xs">examples/minimal</code> en küçük çalışan
        hâl, <code class="font-mono text-xs">examples/blog</code> framework'ün
        her yüzeyini kullanan orta ölçekli bir site,
        <code class="font-mono text-xs">examples/marketing</code> ise
        okuduğunuz bu sayfa.
      </p>
      <p class="mt-3 mb-0">
        Sunucu ayaktayken <code class="font-mono text-xs">node smoke.mjs</code>
        uçların beklendiği gibi yanıt verdiğini doğrular.
      </p>
    </div>
  </div>
</section>
