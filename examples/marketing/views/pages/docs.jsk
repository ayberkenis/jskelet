{#
  Belge dizini. Belge sayfalarıyla aynı kabuğu kullanıyor: okuyucu dizinden bir
  bölüme geçtiğinde sol gezinme yerinde kalıyor, sayfa yeniden kurulmuyor gibi
  hissettiriyor. Kartlar artık GitHub'a değil sitenin kendi sayfalarına gidiyor.
#}
<div class="mx-auto grid max-w-[95rem] gap-x-10 px-5 lg:grid-cols-[15rem_minmax(0,1fr)]">
  <details class="glass-panel mt-6 lg:hidden">
    <summary class="flex cursor-pointer items-center gap-2 px-4 py-3 text-sm font-semibold marker:content-['']">
      <Icon name="SidebarSimple" :size="16" />
      {{ t.docs.shell.browse }}
    </summary>
    <div class="border-t border-slate-200 p-3 dark:border-white/10">
      {# Aynı adı taşıyan iki `<nav>` ekran okuyucuda ayırt edilemez. #}
      <DocsSidebar
        :groups="docsNav"
        :pathname="pathname"
        :labels="docsBrowseLabels"
        :release="release"
        :indexHref="paths.docs"
        :indexLabel="t.docs.shell.overview"
      />
    </div>
  </details>

  <aside class="hidden lg:block">
    <div class="sticky top-[4.5rem] max-h-[calc(100vh-5.5rem)] overflow-y-auto py-10 pr-2">
      <DocsSidebar
        :groups="docsNav"
        :pathname="pathname"
        :labels="t.docs.shell"
        :release="release"
        :indexHref="paths.docs"
        :indexLabel="t.docs.shell.overview"
      />
    </div>
  </aside>

  <div class="min-w-0 py-10 lg:py-14">
    <SectionHead :section="t.docs.hero" :level="1" />

    <div class="mt-8 flex flex-wrap gap-3">
      <ButtonLink
        :href="docsStartHref"
        :text="t.docs.shell.start"
        icon="ArrowRight"
      />
      <ButtonLink :href="paths.download" :text="t.ui.download" variant="ghost" />
    </div>

    {# Gruplar dizinde de korunuyor: sidebar ile aynı zihinsel harita. #}
    {#each docsNav as group}
    <section class="mt-12">
      <h2 class="m-0 text-xs font-bold tracking-[0.16em] text-slate-500 uppercase dark:text-slate-400">
        {{ group.title }}
      </h2>
      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        {#each group.items as item}
        <DocsCard
          :href="item.href"
          :index="summaries[item.slug].index"
          :title="item.label"
          :body="summaries[item.slug].body"
          :hint="t.docs.openLabel"
        />
        {/each}
      </div>
    </section>
    {/each}

    <div class="mt-14 grid gap-4 sm:grid-cols-2">
      <CodeBlock
        :label="t.docs.examples.label"
        :copy="copyLabels"
        :code="docsExampleCode"
      />

      <div class="glass-panel glass-panel--lit p-6">
        <h2 class="m-0 text-base font-semibold">{{ t.docs.examples.title }}</h2>
        <p class="mt-2 mb-0 text-sm/6 text-slate-600 dark:text-slate-300">
          {{ t.docs.examples.body }}
        </p>
        <p class="mt-3 mb-0 text-sm/6 text-slate-600 dark:text-slate-300">
          {{ t.docs.examples.note }}
        </p>
      </div>
    </div>
  </div>
</div>
