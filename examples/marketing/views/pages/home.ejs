<%#
  Ana sayfa. Sayfadaki her sayı ya sitenin kendi build çıktısından ölçülüyor
  (`lib/payload.js`), ya kurulu paketin künyesinden okunuyor
  (`lib/release.js`), ya da ziyaretçinin tarayıcısında ölçülüyor (`latency`
  island'ı, kıyaslama sayfasında). Uydurma benchmark yok — bir framework'ün
  pazarlama sayfasında en kolay kaybedilen şey güven.

  Şablon dil bilmiyor: her metin `t` sözlüğünden, her bağlantı `paths`
  haritasından geliyor.
-%>
<section class="glow relative isolate overflow-hidden border-b border-slate-200 dark:border-white/10">
  <div class="grid-surface pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
  <div class="wrapper grid gap-14 py-20 sm:py-28 lg:grid-cols-[1.05fr_.95fr] lg:items-center lg:py-32">
    <div>
      <%- pill({
        text: format(t.home.badge, release.nodeLabel, format(t.ui.license, release.license)),
        tone: "sky",
      }) %>

      <h1 class="mt-6 text-5xl font-bold tracking-[-0.055em] text-balance sm:text-6xl lg:text-7xl">
        <%= t.home.headline %><br>
        <span class="bg-gradient-to-r from-cyan-700 via-sky-700 to-indigo-700 bg-clip-text text-transparent dark:from-cyan-300 dark:via-sky-300 dark:to-indigo-300"><%= t.home.headlineAccent %></span>
      </h1>

      <p class="mt-6 max-w-xl text-lg/8 text-slate-600 sm:text-xl/8 dark:text-slate-300">
        <%= t.home.lead %>
      </p>

      <div class="mt-9 flex flex-wrap gap-3">
        <%- buttonLink({ href: paths.howItWorks, text: t.home.ctaPrimary, icon: "ArrowRight" }) %>
        <%- buttonLink({
          href: paths.download,
          text: format(t.home.ctaSecondary, release.version),
          variant: "ghost",
          icon: "DownloadSimple",
        }) %>
      </div>

      <div class="mt-9 flex flex-wrap gap-x-6 gap-y-3 text-xs font-semibold tracking-wide text-slate-600 uppercase dark:text-slate-400">
        <% t.home.chips.forEach(function (chip, index) { %>
        <span class="flex items-center gap-2">
          <span class="size-1.5 rounded-full <%= ["bg-cyan-400", "bg-indigo-400", "bg-emerald-400"][index % 3] %>"></span>
          <%= chip %>
        </span>
        <% }); %>
      </div>
    </div>

    <%# Logo bir ürün görseli gibi merkezde; çevresindeki kartlar mimariyi tek bakışta anlatır. %>
    <div class="relative mx-auto min-h-[30rem] w-full max-w-xl" aria-label="<%= t.home.hero.diagramLabel %>">
      <div class="absolute inset-8 rounded-[3rem] bg-gradient-to-br from-cyan-300/25 via-indigo-300/10 to-transparent blur-3xl" aria-hidden="true"></div>
      <div class="absolute top-8 left-1/2 flex size-64 -translate-x-1/2 items-center justify-center rounded-[3rem] border border-white/70 bg-white/75 shadow-2xl shadow-cyan-950/10 backdrop-blur-xl dark:border-white/10 dark:bg-white/[0.06]">
        <img
          src="https://cdn.ayberkenis.com.tr/jskelet/jskelet.png"
          alt="<%= t.home.hero.logoAlt %>"
          width="220"
          height="220"
          class="logo-orbit size-52 object-contain"
        >
      </div>

      <div class="absolute top-4 left-0 rounded-2xl border border-slate-200 bg-white/90 p-4 shadow-xl backdrop-blur dark:border-white/10 dark:bg-[#0c1124]/90">
        <p class="m-0 text-[10px] font-bold tracking-[0.18em] text-slate-600 uppercase dark:text-slate-400"><%= t.home.hero.responseLabel %></p>
        <p class="mt-1 mb-0 font-mono text-sm font-semibold text-emerald-700 dark:text-emerald-300"><%= t.home.hero.responseValue %></p>
      </div>

      <div class="absolute top-40 right-0 rounded-2xl border border-slate-200 bg-white/90 p-4 shadow-xl backdrop-blur dark:border-white/10 dark:bg-[#0c1124]/90">
        <p class="m-0 text-[10px] font-bold tracking-[0.18em] text-slate-600 uppercase dark:text-slate-400"><%= t.home.hero.clientLabel %></p>
        <p class="mt-1 mb-0 font-mono text-sm font-semibold text-cyan-700 dark:text-cyan-300"><%= t.home.hero.clientValue %></p>
      </div>

      <div class="absolute right-6 bottom-16 left-6 overflow-hidden rounded-3xl border border-slate-200 bg-[#090d1d] p-5 text-white shadow-2xl shadow-slate-950/25">
        <div class="mb-4 flex items-center gap-2 border-b border-white/10 pb-3">
          <span class="size-2 rounded-full bg-rose-400"></span>
          <span class="size-2 rounded-full bg-amber-300"></span>
          <span class="size-2 rounded-full bg-emerald-400"></span>
          <span class="ml-auto font-mono text-[10px] text-slate-500"><%= t.home.hero.terminalLabel %></span>
        </div>
        <p class="m-0 font-mono text-xs/6 text-slate-300"><span class="text-cyan-300">$</span> <%= commands.init %></p>
        <% t.home.hero.terminalLines.forEach(function (line) { %>
        <p class="m-0 font-mono text-xs/6 text-slate-300"><span class="text-emerald-300">✓</span> <%= line %></p>
        <% }); %>
        <p class="m-0 font-mono text-xs/6 text-white"><span class="text-indigo-300">→</span> http://localhost:3000</p>
      </div>
    </div>
  </div>

  <div class="overflow-hidden border-t border-slate-200/80 bg-white/40 py-3 dark:border-white/10 dark:bg-white/[0.02]">
    <div class="marquee-track flex w-max items-center gap-10 pr-10 text-xs font-bold tracking-[0.18em] text-slate-600 uppercase dark:text-slate-400">
      <%# İki tur basılıyor: kaydırma yarıya geldiğinde başa dönmesi için. %>
      <% for (let repeat = 0; repeat < 2; repeat += 1) { %>
      <% t.home.marquee.forEach(function (item) { %>
      <span><%= item %></span><span aria-hidden="true">◆</span>
      <% }); %>
      <% } %>
    </div>
  </div>
</section>

<section class="wrapper py-16 sm:py-20">
  <%- sectionHead(t.home.pillars) %>

  <div class="mt-10 grid gap-5 md:grid-cols-3">
    <% pillars.forEach(function (item) { %>
    <%- featureCard(item) %>
    <% }); %>
  </div>
</section>

<section class="border-y border-slate-200 bg-slate-50 py-16 sm:py-20 dark:border-white/10 dark:bg-white/[0.02]">
  <div class="wrapper">
    <%- sectionHead(t.home.payload) %>

    <div class="mt-10 grid gap-8 lg:grid-cols-[1.15fr_1fr] lg:items-start">
      <%- payloadTable({ payload, labels: t.payloadLabels }) %>

      <div class="grid gap-4 sm:grid-cols-2">
        <%- statCard({
          value: payload.total ? bytes(payload.total.gzip) : "—",
          label: t.home.payload.totalLabel,
          note: t.home.payload.totalNote,
          tone: "sky",
        }) %>
        <%- statCard({
          value: t.home.payload.fontsValue,
          label: t.home.payload.fontsLabel,
          note: t.home.payload.fontsNote,
        }) %>
        <%- statCard({
          value: t.home.payload.blockingValue,
          label: t.home.payload.blockingLabel,
          note: t.home.payload.blockingNote,
        }) %>
        <%- statCard({
          value: t.home.payload.eagerValue,
          label: t.home.payload.eagerLabel,
          note: t.home.payload.eagerNote,
        }) %>
      </div>
    </div>

    <p class="mt-6 max-w-2xl text-xs/5 text-slate-600 dark:text-slate-400">
      <%= t.home.payload.footnote %>
    </p>
  </div>
</section>

<section class="wrapper py-16 sm:py-20">
  <div class="grid gap-10 lg:grid-cols-2 lg:items-center">
    <div>
      <%- sectionHead(t.home.cache) %>

      <ul class="mt-6 grid list-none gap-3 p-0 text-sm/6 text-slate-600 dark:text-slate-300">
        <% t.home.cache.points.forEach(function (point) { %>
        <li class="flex gap-2.5">
          <span aria-hidden="true" class="<%= point.tone === "bad" ? "text-rose-700 dark:text-rose-300" : "text-cyan-700 dark:text-cyan-300" %>">→</span>
          <span><%= point.text %></span>
        </li>
        <% }); %>
      </ul>
    </div>

    <%- codeBlock({
      label: t.home.cache.codeLabel,
      code: `export default function register(app, { route, notFound }) {
  app.get("/", route(
    async () => ({
      view: "pages/home",
      data: { pillars },
    }),
    { revalidate: 3600 },
  ));

  app.get("/product/:slug", route(async ({ params }) => {
    const product = await getProduct(params.slug);
    if (!product) notFound();
    return { view: "pages/product", data: { product } };
  }));
}`,
    }) %>
  </div>
</section>

<section class="border-t border-slate-200 py-16 sm:py-20 dark:border-white/10">
  <div class="wrapper">
    <%- sectionHead(t.home.fit) %>

    <div class="mt-10 grid gap-5 md:grid-cols-2">
      <%- fitList({ title: t.fit.title.good, items: fit.good, tone: "good" }) %>
      <%- fitList({ title: t.fit.title.bad, items: fit.bad, tone: "bad" }) %>
    </div>
  </div>
</section>

<section class="border-t border-slate-200 py-16 sm:py-20 dark:border-white/10">
  <div class="wrapper max-w-3xl">
    <%- sectionHead({ eyebrow: t.home.faq.eyebrow, title: t.home.faq.title }) %>

    <div class="mt-8 divide-y divide-slate-200 dark:divide-white/10">
      <%#
        Native `<details>`: açılır kapanır liste için island yazmak, JS'siz de
        çalışan bir davranışı JS'e bağımlı hâle getirmek olurdu.
      -%>
      <% faq.forEach(function (item) { %>
      <details class="group py-4">
        <summary class="flex cursor-pointer items-center justify-between gap-4 text-sm font-semibold marker:content-['']">
          <%= item.q %>
          <span class="text-slate-500 transition-transform group-open:rotate-45 dark:text-slate-400" aria-hidden="true">+</span>
        </summary>
        <p class="mt-3 mb-0 text-sm/6 text-slate-600 dark:text-slate-300"><%= item.a %></p>
      </details>
      <% }); %>
    </div>

    <p class="mt-8 text-sm text-slate-600 dark:text-slate-300">
      <%- format(
        esc(t.home.faq.more),
        link({ href: paths.migrate, text: t.home.faq.moreLink, class: "font-semibold text-cyan-700 underline dark:text-cyan-300" }),
      ) %>
    </p>
  </div>
</section>

<section class="border-t border-slate-200 bg-slate-50 py-16 dark:border-white/10 dark:bg-white/[0.02]">
  <div class="wrapper flex flex-col items-start gap-6 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h2 class="m-0 text-2xl font-bold tracking-tight"><%= t.home.finalCta.title %></h2>
      <p class="mt-2 mb-0 text-sm/6 text-slate-600 dark:text-slate-300">
        <%= t.home.finalCta.body %>
      </p>
    </div>
    <div class="flex flex-wrap gap-3">
      <%- buttonLink({ href: paths.download, text: t.home.finalCta.primary, icon: "DownloadSimple" }) %>
      <%- buttonLink({ href: paths.docs, text: t.home.finalCta.secondary, variant: "ghost" }) %>
    </div>
  </div>
</section>
