<%#
  Ana sayfa. Sayfadaki her sayı ya sitenin kendi build çıktısından ölçülüyor
  (`lib/payload.js`) ya da ziyaretçinin tarayıcısında ölçülüyor (`latency`
  island'ı). Uydurma benchmark yok — bir framework'ün pazarlama sayfasında en
  kolay kaybedilen şey güven.
-%>
<section class="glow border-b border-slate-200 dark:border-slate-800">
  <div class="wrapper py-20 sm:py-28">
    <div class="max-w-3xl">
      <%- pill({ text: "Alpha · Node 22+ · MIT", tone: "sky" }) %>

      <h1 class="mt-5 text-4xl font-bold tracking-tight text-balance sm:text-5xl">
        Sunucuda tam HTML. Yalnızca gereken yerde JavaScript.
      </h1>

      <p class="mt-5 max-w-2xl text-lg/8 text-slate-600 dark:text-slate-300">
        JSkelet, SEO ve hız odaklı siteler için framework'süz hissettiren bir
        framework. Express 5 üzerinde EJS ile sayfanın tamamını basar,
        etkileşimi vanilla JS island'larla ekler ve ISR yerine süreç belleğinde
        yaşayan, stale-while-revalidate'li bir HTML TTL cache kullanır.
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <%- buttonLink({ href: "/nasil-calisir", text: "Nasıl çalışır", icon: "ArrowRight" }) %>
        <%- buttonLink({ href: "/kiyaslama", text: "Kıyaslamayı gör", variant: "ghost" }) %>
      </div>

      <div class="mt-8 max-w-xl">
        <%- codeBlock({
          label: "npm'de değil: git üzerinden kurulur",
          copyable: true,
          code: "npm install github:ayberkenis/jskelet\nnpx jskelet init\nnpx jskelet dev",
        }) %>
      </div>
    </div>
  </div>
</section>

<section class="wrapper py-16 sm:py-20">
  <%- sectionHead({
    eyebrow: "Üç karar",
    title: "Framework'ün tamamı bu üç karardan çıkıyor",
    lead: "Gerisi bu kararların sonucu: hangi dosyanın nerede durduğu, neyin cache'lendiği, neyin client'a indiği.",
  }) %>

  <div class="mt-10 grid gap-5 md:grid-cols-3">
    <% pillars.forEach(function (item) { %>
    <%- featureCard(item) %>
    <% }); %>
  </div>
</section>

<section class="border-y border-slate-200 bg-slate-50 py-16 sm:py-20 dark:border-slate-800 dark:bg-slate-900/30">
  <div class="wrapper">
    <%- sectionHead({
      eyebrow: "Ölçüm",
      title: "Bu sayfanın gerçek ağırlığı",
      lead: "Aşağıdaki bayt sayıları bir sunum slaytından değil, bu sitenin build çıktısından geliyor: istek anında diskten okunup gzip'lendi.",
    }) %>

    <div class="mt-10 grid gap-8 lg:grid-cols-[1.15fr_1fr] lg:items-start">
      <%- payloadTable(payload) %>

      <div class="grid gap-4 sm:grid-cols-2">
        <%- statCard({
          value: payload.total ? bytes(payload.total.gzip) : "—",
          label: "Her şey dahil (gzip)",
          note: "Stylesheet, entry, sprite ve sitedeki bütün island'lar birlikte. Tek bir sayfa bunun hepsini indirmiyor.",
          tone: "sky",
        }) %>
        <%- statCard({
          value: "0",
          label: "Web font isteği",
          note: "Sistem font yığını. FOUT ve font kaynaklı CLS yok.",
        }) %>
        <%- statCard({
          value: "1",
          label: "Render'ı bloke eden istek",
          note: "Tek stylesheet. Client entry modül olduğu için defer edilmiş.",
        }) %>
        <%- statCard({
          value: "2",
          label: "Bu sayfada hemen inen island",
          note: "Tema ve mobil menü. Kalan island'lar yalnızca görünürlüğe girerse iner.",
        }) %>
      </div>
    </div>

    <p class="mt-6 max-w-2xl text-xs text-slate-500 dark:text-slate-400">
      Karşılaştırılabilir bir sayı istiyorsanız kendi projenizin ağırlığını aynı
      şekilde ölçün: bir framework'ün "hafif" olduğu iddiası, ancak sizin
      sayfanızda ölçüldüğünde bir şey ifade eder.
    </p>
  </div>
</section>

<section class="wrapper py-16 sm:py-20">
  <div class="grid gap-10 lg:grid-cols-2 lg:items-center">
    <div>
      <%- sectionHead({
        eyebrow: "Cache",
        title: "TTL dolduğunda kimse beklemez",
        lead: "Süre biten HTML anında döner, tazeleme arkada yürür. Route'un tek bildiği ikinci bir parametre.",
      }) %>

      <ul class="mt-6 grid list-none gap-3 p-0 text-sm/6 text-slate-600 dark:text-slate-300">
        <li class="flex gap-2"><span aria-hidden="true" class="text-sky-500">→</span> Anahtar <code class="font-mono text-xs">path?query</code>; HIT durumunda controller hiç çalışmaz.</li>
        <li class="flex gap-2"><span aria-hidden="true" class="text-sky-500">→</span> Açılışta prewarm sayfaları önden render eder; ilk ziyaretçi soğuk cache'e denk gelmez.</li>
        <li class="flex gap-2"><span aria-hidden="true" class="text-sky-500">→</span> Yanıtta <code class="font-mono text-xs">X-JSkelet-Cache: HIT | STALE | MISS</code> — ölçmek için ayrı bir araç gerekmiyor.</li>
        <li class="flex gap-2"><span aria-hidden="true" class="text-rose-400">→</span> Nokta atışı geçersizleme yok: TTL ve tümünü boşaltma var.</li>
      </ul>
    </div>

    <%- codeBlock({
      label: "routes/10-pages.mjs",
      code: `export default function register(app, { route, notFound }) {
  app.get("/", route(
    async () => ({
      view: "pages/home",
      metadata: { title: "Ana sayfa", canonical: "/" },
      data: { pillars },
    }),
    { revalidate: 3600 }, // HTML bir saat bellekte
  ));

  app.get("/urun/:slug", route(async ({ params }) => {
    const product = await getProduct(params.slug);
    if (!product) notFound();
    return { view: "pages/product", data: { product } };
  }));
}`,
    }) %>
  </div>
</section>

<section class="border-t border-slate-200 py-16 sm:py-20 dark:border-slate-800">
  <div class="wrapper">
    <%- sectionHead({
      eyebrow: "Dürüst bölüm",
      title: "Her site için doğru araç değil",
      lead: "Cache'lenen HTML herkese aynı gider. Bu, içerik sitelerinde en büyük kazanç; oturum arkasında yaşayan arayüzlerde ise doğrudan bir engel.",
    }) %>

    <div class="mt-10 grid gap-5 md:grid-cols-2">
      <%- fitList({ title: "İyi uyum", items: fit.good, tone: "good" }) %>
      <%- fitList({ title: "Yanlış seçim", items: fit.bad, tone: "bad" }) %>
    </div>
  </div>
</section>

<section class="border-t border-slate-200 py-16 sm:py-20 dark:border-slate-800">
  <div class="wrapper max-w-3xl">
    <%- sectionHead({ eyebrow: "SSS", title: "Sık sorulanlar" }) %>

    <div class="mt-8 divide-y divide-slate-200 dark:divide-slate-800">
      <%#
        Native `<details>`: açılır kapanır liste için island yazmak, JS'siz de
        çalışan bir davranışı JS'e bağımlı hâle getirmek olurdu.
      -%>
      <% faq.forEach(function (item) { %>
      <details class="group py-4">
        <summary class="flex cursor-pointer items-center justify-between gap-4 text-sm font-semibold marker:content-['']">
          <%= item.q %>
          <span class="text-slate-400 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
        </summary>
        <p class="mt-3 mb-0 text-sm/6 text-slate-600 dark:text-slate-300"><%= item.a %></p>
      </details>
      <% }); %>
    </div>

    <p class="mt-8 text-sm text-slate-600 dark:text-slate-300">
      Kalan sorular ve karşılık tablosu <%- link({ href: "/tasima", text: "taşıma sayfasında", class: "font-medium underline" }) %>.
    </p>
  </div>
</section>

<section class="border-t border-slate-200 bg-slate-50 py-16 dark:border-slate-800 dark:bg-slate-900/30">
  <div class="wrapper flex flex-col items-start gap-6 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h2 class="m-0 text-2xl font-bold tracking-tight">Bir sayfayla dene</h2>
      <p class="mt-2 mb-0 text-sm text-slate-600 dark:text-slate-300">
        <code class="font-mono">npx jskelet init</code> bir route, bir bileşen ve
        bir island'dan oluşan çalışan bir iskelet kurar.
      </p>
    </div>
    <div class="flex flex-wrap gap-3">
      <%- buttonLink({ href: "/belgeler", text: "Belgeler", icon: "ArrowRight" }) %>
      <%- buttonLink({ href: "https://github.com/ayberkenis/jskelet", text: "GitHub", variant: "ghost" }) %>
    </div>
  </div>
</section>
