<section class="glow relative overflow-hidden border-b border-slate-200 dark:border-white/10">
  <div class="grid-surface pointer-events-none absolute inset-0" aria-hidden="true"></div>
  <div class="wrapper relative py-20 sm:py-28">
    <%- sectionHead(t.howItWorks.hero) %>

    <%# Adım şeridi: sayfanın tamamını okumadan önce akışın kaç durağı olduğunu gösterir. %>
    <div class="mt-10 flex max-w-3xl items-center gap-2" aria-hidden="true">
      <% pipeline.forEach(function (item, index) { %>
      <span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-brand-400 font-mono text-xs font-bold text-ink-950"><%= item.step %></span>
      <% if (index < pipeline.length - 1) { %><span class="h-px flex-1 bg-gradient-to-r from-brand-400 to-brand-500/40"></span><% } %>
      <% }); %>
    </div>
  </div>
</section>

<section class="wrapper py-16">
  <%#
    Timeline: çizgi yalnızca daire sütununun ortasından geçer; daireler
    opak zeminle üstte durduğu için çizgi kart gövdesini kesmez.
  -%>
  <ol class="relative grid list-none gap-5 p-0">
    <span
      class="pointer-events-none absolute top-12 bottom-12 left-12 w-px -translate-x-1/2 bg-brand-400/60"
      aria-hidden="true"
    ></span>
    <% pipeline.forEach(function (item) { %>
    <li class="relative grid grid-cols-[3rem_1fr] items-start gap-4 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:gap-5 dark:border-white/10 dark:bg-white/[0.04]">
      <span
        class="relative z-10 inline-flex size-12 items-center justify-center rounded-full bg-brand-400 font-mono text-sm font-bold text-ink-950 shadow-[0_0_24px_rgb(34_211_238_/_0.35)]"
        aria-hidden="true"
      ><%= item.step %></span>
      <div class="min-w-0 pt-1.5">
        <h3 class="m-0 text-lg font-semibold tracking-tight"><%= item.title %></h3>
        <p class="mt-2 mb-0 max-w-3xl text-sm/6 text-slate-600 dark:text-slate-300"><%= item.body %></p>
      </div>
    </li>
    <% }); %>
  </ol>
</section>

<section class="border-t border-slate-200 bg-slate-50 py-16 dark:border-white/10 dark:bg-white/[0.02]">
  <div class="wrapper grid gap-10 lg:grid-cols-2 lg:items-start">
    <div>
      <%- sectionHead({
        eyebrow: t.islandContract.eyebrow,
        title: t.islandContract.title,
        lead: t.islandContract.lead,
      }) %>

      <ul class="mt-6 grid list-none gap-3 p-0 text-sm/6 text-slate-600 dark:text-slate-300">
        <% t.islandContract.points.forEach(function (point) { %>
        <li class="flex gap-2.5">
          <span aria-hidden="true" class="text-brand-500 dark:text-brand-300">→</span>
          <span><%= point %></span>
        </li>
        <% }); %>
      </ul>
    </div>

    <div class="grid gap-4">
      <%- codeBlock({
        label: "views/pages/pricing.ejs",
        // Örnek kodda EJS etiketi olamaz: kapanış ikilisi bu çıktı etiketini
        // erken kapatır ve şablon derlenmez.
        code: `<div\n  data-island="pricing-calculator"\n  data-island-props='{"currency":"USD"}'\n>\n  <!-- the pricing table HTML came from the server -->\n  <table data-seats-table>...</table>\n</div>`,
      }) %>

      <%- codeBlock({
        label: "client/islands/pricing-calculator.js",
        code: `import { on, qs } from "jskelet/client";\n\nexport function mount(element, props) {\n  const input = qs(element, "[data-seats]");\n\n  return on(input, "input", () => {\n    // The table markup came from the server;\n    // the island only updates the number.\n    paint(element, Number(input.value), props.currency);\n  });\n}`,
      }) %>
    </div>
  </div>
</section>

<section class="wrapper py-16">
  <%- sectionHead(t.islandContract.payoff) %>

  <div class="mt-10 grid gap-5 md:grid-cols-3">
    <% pillars.forEach(function (item) { %>
    <%- featureCard(item) %>
    <% }); %>
  </div>

  <div class="mt-10 flex flex-wrap gap-3">
    <%- buttonLink({ href: paths.compare, text: t.islandContract.ctaPrimary, icon: "ArrowRight" }) %>
    <%- buttonLink({ href: paths.docs, text: t.islandContract.ctaSecondary, variant: "ghost" }) %>
  </div>
</section>
