<footer class="border-t border-slate-200 bg-slate-50/70 dark:border-white/10 dark:bg-white/[0.02]">
  <div class="wrapper grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr]">
    <div class="max-w-sm">
      <p class="m-0 flex items-center gap-2.5 text-lg font-bold">
        <%- await include('partials/logo') %>
      </p>
      <p class="mt-3 text-sm/6 text-slate-600 dark:text-slate-400">
        <%= t.ui.footerTagline %>
      </p>
      <p class="mt-3 text-xs/5 text-slate-500 dark:text-slate-400">
        <%= t.ui.footerNote %>
      </p>
    </div>

    <nav class="grid content-start gap-2 text-sm" aria-label="<%= t.ui.mainMenu %>">
      <% nav.forEach(function (item) { %>
      <%- link({
        href: item.href,
        text: item.label,
        class: "text-slate-600 hover:text-cyan-700 hover:underline dark:text-slate-300 dark:hover:text-cyan-300",
      }) %>
      <% }); %>
      <%- link({
        href: paths.download,
        text: t.ui.download,
        class: "text-slate-600 hover:text-cyan-700 hover:underline dark:text-slate-300 dark:hover:text-cyan-300",
      }) %>
    </nav>

    <div class="grid content-start gap-3 text-sm">
      <%#
        Sürüm künyesi kurulu paketten okunuyor; footer'da durması "hangi
        sürüme bakıyorum" sorusunu her sayfada cevaplıyor.
      -%>
      <div class="rounded-2xl border border-slate-200 bg-white p-4 dark:border-white/10 dark:bg-white/[0.035]">
        <p class="m-0 text-[10px] font-bold tracking-[0.18em] text-slate-500 uppercase dark:text-slate-400">
          <%= t.ui.releaseLabel %>
        </p>
        <p class="mt-1 mb-0 font-mono text-lg font-bold">v<%= release.version %></p>
        <p class="mt-2 mb-0 text-xs text-slate-600 dark:text-slate-400">
          <%= format(t.ui.nodeRequirement, release.nodeLabel) %> · <%= format(t.ui.license, release.license) %>
        </p>
        <%- link({
          href: paths.changelog,
          text: t.nav.find((item) => item.key === "changelog").label,
          class: "mt-3 inline-block text-xs font-bold text-cyan-700 hover:underline dark:text-cyan-300",
        }) %>
      </div>

      <div class="flex flex-wrap gap-x-4 gap-y-2 text-sm">
        <%- link({
          href: "https://github.com/ayberkenis/jskelet",
          html: `${icon({ name: "GithubLogo", size: 16 })}<span>${esc(t.ui.githubShort)}</span>`,
          rel: "noopener",
          class: "inline-flex items-center gap-1.5 text-slate-600 hover:text-cyan-700 hover:underline dark:text-slate-300 dark:hover:text-cyan-300",
        }) %>
        <%- link({
          href: "/sitemap.xml",
          text: t.ui.sitemap,
          class: "text-slate-600 hover:text-cyan-700 hover:underline dark:text-slate-300 dark:hover:text-cyan-300",
        }) %>
      </div>
    </div>
  </div>

  <div class="wrapper flex flex-wrap items-center justify-between gap-3 border-t border-slate-200 py-5 text-xs text-slate-600 dark:border-white/10 dark:text-slate-400">
    <span><%= format(t.ui.license, release.license) %> · <%= format(t.ui.nodeRequirement, release.nodeLabel) %></span>

    <div class="flex flex-wrap items-center gap-4">
      <%# Dil seçimi footer'da da duruyor: header'da yalnızca bir ikon var. %>
      <span class="inline-flex items-center gap-2">
        <% languages.forEach(function (language, index) { %>
        <% if (index > 0) { %><span aria-hidden="true" class="text-slate-300 dark:text-slate-600">·</span><% } %>
        <% if (language.current) { %>
        <span class="font-semibold text-slate-900 dark:text-white" aria-current="true"><%= language.label %></span>
        <% } else { %>
        <%- link({
          href: language.href,
          text: language.label,
          attrs: { hreflang: language.locale, lang: language.locale },
          class: "hover:text-cyan-700 hover:underline dark:hover:text-cyan-300",
        }) %>
        <% } %>
        <% }); %>
      </span>

      <span class="inline-flex items-center gap-2">
        <span class="status-pulse size-2 rounded-full bg-emerald-400"></span>
        <%= t.ui.activeDevelopment %>
      </span>
    </div>
  </div>
</footer>
