<footer class="border-t border-slate-200 dark:border-slate-800">
  <div class="wrapper flex flex-col gap-6 py-10 sm:flex-row sm:items-start sm:justify-between">
    <div class="max-w-sm">
      <p class="m-0 flex items-center gap-2 font-semibold">
        <%- await include('partials/logo') %>
      </p>
      <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">
        Bu site JSkelet ile kuruldu ve depodaki
        <code class="font-mono text-xs">examples/marketing</code> örneğinin
        kendisidir. Sayfadaki bayt ölçümleri bu sitenin build çıktısından okunur.
      </p>
    </div>

    <nav class="grid grid-cols-2 gap-x-10 gap-y-2 text-sm">
      <% nav.forEach(function (item) { %>
      <%- link({
        href: item.href,
        text: item.label,
        class: "text-slate-600 hover:underline dark:text-slate-300",
      }) %>
      <% }); %>
      <%- link({ href: "/sitemap.xml", text: "Sitemap", class: "text-slate-600 hover:underline dark:text-slate-300" }) %>
      <%- link({
        href: "https://github.com/ayberkenis/jskelet",
        text: "GitHub",
        rel: "noopener",
        class: "text-slate-600 hover:underline dark:text-slate-300",
      }) %>
    </nav>
  </div>

  <div class="wrapper border-t border-slate-200 py-5 text-xs text-slate-500 dark:border-slate-800 dark:text-slate-400">
    MIT lisanslı. Alpha; genel yüzey 1.0'a kadar değişebilir.
  </div>
</footer>
