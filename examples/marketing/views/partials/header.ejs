<header
  class="sticky top-0 z-40 border-b border-slate-200/70 bg-white/80 backdrop-blur-xl dark:border-white/10 dark:bg-ink-950/80"
>
  <div class="wrapper flex items-center justify-between gap-3 py-3.5">
    <div class="flex items-center gap-3">
      <%#
        Ana sayfada logo <h1>, diğerlerinde <a>. `pathname` varsayılanı boş
        string: "/" yazmak her sayfayı ana sayfa sanmaya yol açıyor.
      -%>
      <% if (pathname === paths.home) { %>
      <h1 class="m-0 flex items-center gap-2.5 text-lg font-bold">
        <%- await include('partials/logo') %>
      </h1>
      <% } else { %>
      <a href="<%= paths.home %>" class="flex items-center gap-2.5 text-lg font-bold">
        <%- await include('partials/logo') %>
      </a>
      <% } %>

      <%#
        Sürüm etiketi sürüm notlarına gider: "hangi sürümü kuruyorum" sorusu
        indirme sayfasına varmadan da cevaplanmış olur.
      -%>
      <%- link({
        href: paths.changelog,
        text: `v${release.version}`,
        title: t.ui.releaseLabel,
        class: "hidden rounded-full border border-cyan-200 bg-cyan-50 px-2.5 py-1 font-mono text-xs font-bold text-cyan-800 transition-colors hover:border-cyan-400 sm:block dark:border-cyan-400/25 dark:bg-cyan-400/10 dark:text-cyan-200",
      }) %>
    </div>

    <div class="flex items-center gap-1.5">
      <nav class="hidden items-center gap-1 lg:flex" aria-label="<%= t.ui.mainMenu %>">
        <% nav.forEach(function (item) { %>
        <%- link({
          href: item.href,
          text: item.label,
          class: cn(
            "rounded-xl px-3 py-2 text-sm transition-colors",
            item.active
              ? "bg-cyan-50 font-semibold text-cyan-800 dark:bg-cyan-400/10 dark:text-cyan-200"
              : "text-slate-600 hover:bg-slate-100 hover:text-slate-950 dark:text-slate-300 dark:hover:bg-white/5 dark:hover:text-white",
          ),
        }) %>
        <% }); %>
      </nav>

      <%#
        Dil değiştirici: iki dil olduğu için açılır menüye gerek yok, karşı
        dilin kısaltması doğrudan bir bağlantı. JS'siz de çalışır.
      -%>
      <% languages.filter((language) => !language.current).forEach(function (language) { %>
      <%- link({
        href: language.href,
        html: `${icon({ name: "Translate", size: 16 })}<span>${esc(language.short)}</span>`,
        attrs: { hreflang: language.locale, lang: language.locale },
        title: `${t.ui.languageSwitch}: ${language.label}`,
        class: "inline-flex items-center gap-1.5 rounded-xl border border-slate-300 bg-white/60 px-2.5 py-2 text-xs font-bold text-slate-700 transition-colors hover:border-cyan-400 hover:text-cyan-700 dark:border-white/15 dark:bg-white/5 dark:text-slate-200 dark:hover:border-cyan-300/50 dark:hover:text-cyan-200",
      }) %>
      <% }); %>

      <%- link({
        href: "https://github.com/ayberkenis/jskelet",
        html: `${icon({ name: "GithubLogo", size: 18 })}<span class="sr-only">${esc(t.ui.github)}</span>`,
        rel: "noopener",
        title: t.ui.github,
        class: "inline-flex items-center rounded-xl border border-slate-300 bg-white/60 p-2.5 text-slate-700 transition-colors hover:border-cyan-400 hover:text-cyan-700 dark:border-white/15 dark:bg-white/5 dark:text-slate-200 dark:hover:border-cyan-300/50 dark:hover:text-cyan-200",
      }) %>

      <%#
        `data-island-eager`: görünürlüğü beklemez. Tema ve menü gibi global
        davranışlar için doğru strateji.
      -%>
      <button
        type="button"
        data-island="theme-toggle"
        data-island-eager
        class="rounded-xl border border-slate-300 bg-white/60 p-2.5 text-slate-700 hover:bg-slate-50 dark:border-white/15 dark:bg-white/5 dark:text-slate-200 dark:hover:bg-white/10"
        aria-label="<%= t.ui.toggleTheme %>"
      >
        <%# Sunucu açık temayı varsayar; koyu temada island bunu ters çevirir. %>
        <span data-theme-icon="dark"><%- icon({ name: "Moon", size: 18 }) %></span>
        <span data-theme-icon="light" hidden><%- icon({ name: "Sun", size: 18 }) %></span>
      </button>

      <%- link({
        href: paths.download,
        html: `${icon({ name: "DownloadSimple", size: 16 })}<span>${esc(t.ui.download)}</span>`,
        class: "hidden items-center gap-2 rounded-xl bg-slate-950 px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-cyan-700 sm:inline-flex dark:bg-cyan-300 dark:text-slate-950 dark:hover:bg-white",
      }) %>

      <button
        type="button"
        data-island="nav-toggle"
        data-island-eager
        class="rounded-xl border border-slate-300 bg-white/60 p-2.5 lg:hidden dark:border-white/15 dark:bg-white/5"
        aria-label="<%= t.ui.openMenu %>"
        aria-expanded="false"
        aria-controls="mobile-nav"
      ><%- icon({ name: "List", size: 18 }) %></button>
    </div>
  </div>

  <nav
    id="mobile-nav"
    class="wrapper hidden flex-col gap-1 pb-4 lg:hidden"
    aria-label="<%= t.ui.mobileMenu %>"
  >
    <% nav.forEach(function (item) { %>
    <%- link({
      href: item.href,
      text: item.label,
      class: cn(
        "rounded-xl px-3 py-2.5 text-sm",
        item.active
          ? "bg-cyan-50 font-semibold text-cyan-800 dark:bg-cyan-400/10 dark:text-cyan-200"
          : "text-slate-700 hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-white/5",
      ),
    }) %>
    <% }); %>

    <%- link({
      href: paths.download,
      text: t.ui.download,
      class: "mt-1 rounded-xl bg-slate-950 px-3 py-2.5 text-center text-sm font-semibold text-white dark:bg-cyan-300 dark:text-slate-950",
    }) %>
  </nav>
</header>
