<header
  class="sticky top-0 z-40 border-b border-slate-200/80 bg-white/85 backdrop-blur dark:border-slate-800/80 dark:bg-slate-950/85"
>
  <div class="wrapper flex items-center justify-between gap-4 py-3">
    <%#
      Ana sayfada logo <h1>, diğerlerinde <a>. `pathname` varsayılanı boş
      string: "/" yazmak her sayfayı ana sayfa sanmaya yol açıyor.
    -%>
    <% if (pathname === "/") { %>
    <h1 class="m-0 flex items-center gap-2 text-base font-bold tracking-tight">
      <%- await include('partials/logo') %>
    </h1>
    <% } else { %>
    <a href="/" class="flex items-center gap-2 text-base font-bold tracking-tight">
      <%- await include('partials/logo') %>
    </a>
    <% } %>

    <div class="flex items-center gap-1">
      <nav class="hidden items-center gap-1 md:flex" aria-label="Ana menü">
        <% nav.forEach(function (item) { %>
        <%- link({
          href: item.href,
          text: item.label,
          class: cn(
            "rounded-md px-3 py-2 text-sm transition-colors",
            pathname === item.href
              ? "bg-slate-100 font-semibold text-slate-900 dark:bg-slate-800 dark:text-white"
              : "text-slate-600 hover:bg-slate-100 hover:text-slate-900 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-white",
          ),
        }) %>
        <% }); %>
      </nav>

      <%- link({
        href: "https://github.com/ayberkenis/jskelet",
        text: "GitHub",
        rel: "noopener",
        class: "hidden rounded-md border border-slate-300 px-3 py-2 text-sm font-medium hover:bg-slate-50 sm:block dark:border-slate-700 dark:hover:bg-slate-800",
      }) %>

      <%#
        `data-island-eager`: görünürlüğü beklemez. Tema ve menü gibi global
        davranışlar için doğru strateji.
      -%>
      <button
        type="button"
        data-island="theme-toggle"
        data-island-eager
        class="rounded-md border border-slate-300 p-2 text-slate-700 hover:bg-slate-50 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800"
        aria-label="Temayı değiştir"
      >
        <%# Sunucu açık temayı varsayar; koyu temada island bunu ters çevirir. %>
        <span data-theme-icon="dark"><%- icon({ name: "Moon", size: 18 }) %></span>
        <span data-theme-icon="light" hidden><%- icon({ name: "Sun", size: 18 }) %></span>
      </button>

      <button
        type="button"
        data-island="nav-toggle"
        data-island-eager
        class="rounded-md border border-slate-300 p-2 md:hidden dark:border-slate-700"
        aria-label="Menüyü aç"
        aria-expanded="false"
        aria-controls="mobile-nav"
      ><%- icon({ name: "List", size: 18 }) %></button>
    </div>
  </div>

  <nav
    id="mobile-nav"
    class="wrapper hidden flex-col gap-1 pb-3 md:hidden"
    aria-label="Mobil menü"
  >
    <% nav.forEach(function (item) { %>
    <%- link({
      href: item.href,
      text: item.label,
      class: "rounded-md px-3 py-2 text-sm text-slate-700 hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-800",
    }) %>
    <% }); %>
  </nav>
</header>
