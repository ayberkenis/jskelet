<header
  class="sticky top-0 z-40 border-b border-slate-200/70 bg-white/75 backdrop-blur-xl dark:border-white/10 dark:bg-ink-950/80"
>
  <div class="wrapper flex items-center justify-between gap-3 py-3.5">
    <div class="flex items-center gap-3">
      {#
        Logo asla H1 değil: sayfanın birincil başlığı içerikte kalır. Ana
        sayfada da home'a giden bir bağlantı; kendini işaret etmek zararsız
        ve diğer sayfalarla aynı işaretlemeyi korur.
      #}
      <a :href="paths.home" class="flex items-center gap-2.5 text-lg font-bold">
        {#include "partials/logo"}
      </a>

      {#
        Sürüm etiketi sürüm notlarına gider: "hangi sürümü kuruyorum" sorusu
        indirme sayfasına varmadan da cevaplanmış olur.
      #}
      <Link
        :href="paths.changelog"
        :text="releaseVersionLabel"
        :title="t.ui.releaseLabel"
        class="hidden rounded-full border border-cyan-200 bg-cyan-50 px-2.5 py-1 font-mono text-xs font-bold text-cyan-800 transition-colors hover:border-brand-400 sm:block dark:border-brand-400/30 dark:bg-brand-400/10 dark:text-brand-300"
      />
    </div>

    <div class="flex items-center gap-1.5">
      <nav class="hidden items-center gap-1 lg:flex" :aria-label="t.ui.mainMenu">
        {#each nav as item}
        <Link
          :href="item.href"
          :text="item.label"
          :class="item.class"
        />
        {/each}
      </nav>

      {#
        Dil değiştirici: iki dil olduğu için açılır menüye gerek yok, karşı
        dilin kısaltması doğrudan bir bağlantı. JS'siz de çalışır.
      #}
      {#each otherLanguages as language}
      <a
        :href="language.href"
        :hreflang="language.locale"
        :lang="language.locale"
        :title="language.switchTitle"
        class="inline-flex items-center gap-1.5 rounded-xl border border-slate-300 bg-white/60 px-2.5 py-2 text-xs font-bold text-slate-700 transition-colors hover:border-brand-400 hover:text-cyan-700 dark:border-white/15 dark:bg-white/5 dark:text-slate-200 dark:hover:border-brand-400/50 dark:hover:text-brand-300"
      >
        <Icon name="Translate" :size="16" />
        <span>{{ language.short }}</span>
      </a>
      {/each}

      <a
        href="https://github.com/ayberkenis/jskelet"
        rel="noopener"
        :title="t.ui.github"
        class="inline-flex items-center gap-1.5 rounded-xl border border-slate-300 bg-white/60 px-2.5 py-2 text-sm font-medium text-slate-700 transition-colors hover:border-brand-400 hover:text-cyan-700 dark:border-white/15 dark:bg-white/5 dark:text-slate-200 dark:hover:border-brand-400/50 dark:hover:text-brand-300"
      >
        <Icon name="GithubLogo" :size="16" />
        <span class="hidden sm:inline">{{ t.ui.githubShort }}</span>
      </a>

      {#
        `data-island-eager`: görünürlüğü beklemez. Tema ve menü gibi global
        davranışlar için doğru strateji.
      #}
      <button
        type="button"
        data-island="theme-toggle"
        data-island-eager
        class="rounded-xl border border-slate-300 bg-white/60 p-2.5 text-slate-700 hover:bg-slate-50 dark:border-white/15 dark:bg-white/5 dark:text-slate-200 dark:hover:bg-white/10"
        :aria-label="t.ui.toggleTheme"
      >
        {# Sunucu açık temayı varsayar; koyu temada island bunu ters çevirir. #}
        <span data-theme-icon="dark"><Icon name="Moon" :size="18" /></span>
        <span data-theme-icon="light" hidden><Icon name="Sun" :size="18" /></span>
      </button>

      <a
        :href="paths.download"
        class="hidden items-center gap-2 rounded-xl bg-brand-400 px-4 py-2.5 text-sm font-semibold text-ink-950 shadow-lg shadow-brand-400/20 transition-colors hover:bg-brand-300 sm:inline-flex"
      >
        <Icon name="DownloadSimple" :size="16" />
        <span>{{ t.ui.download }}</span>
      </a>

      <button
        type="button"
        data-island="nav-toggle"
        data-island-eager
        class="rounded-xl border border-slate-300 bg-white/60 p-2.5 lg:hidden dark:border-white/15 dark:bg-white/5"
        :aria-label="t.ui.openMenu"
        aria-expanded="false"
        aria-controls="mobile-nav"
      ><Icon name="List" :size="18" /></button>
    </div>
  </div>

  <nav
    id="mobile-nav"
    class="wrapper hidden flex-col gap-1 pb-4 lg:hidden"
    :aria-label="t.ui.mobileMenu"
  >
    {#each nav as item}
    <Link
      :href="item.href"
      :text="item.label"
      :class="item.mobileClass"
    />
    {/each}

    <Link
      :href="paths.download"
      :text="t.ui.download"
      class="mt-1 rounded-xl bg-brand-400 px-3 py-2.5 text-center text-sm font-semibold text-ink-950"
    />
  </nav>
</header>
