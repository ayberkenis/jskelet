{
  "name": "jskelet",
  "version": "0.1.9",
  "description": "A framework that feels like no framework: Express 5 + EJS server rendering, vanilla JS islands, Tailwind v4 and an in-process HTML TTL cache.",
  "type": "module",
  "license": "MIT",
  "author": "Ayberk Enis",
  "homepage": "https://github.com/ayberkenis/jskelet#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ayberkenis/jskelet.git"
  },
  "bugs": {
    "url": "https://github.com/ayberkenis/jskelet/issues"
  },
  "keywords": [
    "ssr",
    "islands",
    "express",
    "ejs",
    "esbuild",
    "tailwind",
    "seo",
    "isr"
  ],
  "bin": {
    "jskelet": "./bin/jskelet.mjs"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./server": "./src/index.js",
    "./client": "./src/client/index.js",
    "./html": "./src/views/helpers/html.js",
    "./tags": "./src/views/helpers/tags.js",
    "./cookies": "./src/http/cookies.js",
    "./log": "./src/log.mjs",
    "./register": "./src/runtime/register.mjs",
    "./layout": "./src/templates/layout.ejs"
  },
  "files": [
    "bin",
    "src",
    "docs",
    "README.md",
    "AGENTS.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint",
    "test": "node --test \"test/**/*.test.mjs\"",
    "example:minimal": "npm --prefix examples/minimal run dev",
    "example:blog": "npm --prefix examples/blog run dev",
    "example:dashboard": "npm --prefix examples/dashboard run dev"
  },
  "dependencies": {
    "ejs": "^6.0.1",
    "esbuild": "^0.28.2",
    "express": "^5.2.1",
    "tailwind-merge": "^3.5.0"
  },
  "peerDependencies": {
    "@phosphor-icons/core": "^2.1.1",
    "@tailwindcss/postcss": "^4.3.3",
    "lightningcss": "^1.32.0",
    "postcss": "^8.5.26",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3"
  },
  "peerDependenciesMeta": {
    "@phosphor-icons/core": {
      "optional": true
    },
    "@tailwindcss/postcss": {
      "optional": true
    },
    "lightningcss": {
      "optional": true
    },
    "postcss": {
      "optional": true
    },
    "sharp": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "eslint": "^9",
    "globals": "^16"
  }
}