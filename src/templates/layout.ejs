<%#
  JSkelet varsayılan layout'unun legacy EJS kopyası.

  Yeni uygulamalar `jskelet/layout` (.jsk) kullanır. Bu dosya yalnızca EJS
  peer'i kurulu eski şablonlar için `jskelet/layout/ejs` üzerinden erişilir.
  Uygulama `views/layout.jsk` veya `views/layout.ejs` oluşturduğu anda
  framework layout'u devre dışı kalır.

  Kullanılabilir local'ler: metadata, headMeta, extraHead, structuredData,
  body, bodyClass, entries, styles, pathname, lang, devtools, devBasePath,
  asset, hasAsset + tüm html/tag helper'ları ve views/components/** export'ları.
  `hooks.layoutContext()` döndürdüğü her alan da buraya eklenir.
-%>
<!DOCTYPE html>
<html lang="<%= lang %>">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%# Kaynak ipuçları en başta: preconnect ve LCP preload'ını geciktirmek
        doğrudan LCP'ye yazılır. Sayfaya özel head buradan gelir. %>
    <%- extraHead %>
    <%- stylesheets({ styles }) %>
    <%- headMeta %>
    <%- jsonLd({ items: structuredData }) %>
  </head>
  <body class="<%= bodyClass %>">
    <%- body %>
    <%- bodyScripts({ entries, devtools, devBasePath }) %>
  </body>
</html>
